@model FilmLibrary.Models.Film

@{
    ViewData["Title"] = "Modifier un film";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">

        <div class="mb-4">
            <h1 class="h2 mb-1">Modifier un film</h1>
            <p class="text-muted mb-0">
                Modifiez les informations du film.
            </p>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">

                <form asp-action="Edit" method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title"
                               class="form-label fw-semibold">
                            Titre
                        </label>

                        <input asp-for="Title"
                               class="form-control" />

                        <span asp-validation-for="Title"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label asp-for="Director"
                                   class="form-label fw-semibold">
                                Réalisateur
                            </label>

                            <input asp-for="Director"
                                   class="form-control" />

                            <span asp-validation-for="Director"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="ReleaseYear"
                                   class="form-label fw-semibold">
                                Année de sortie
                            </label>

                            <input asp-for="ReleaseYear"
                                   class="form-control"
                                   type="number" />

                            <span asp-validation-for="ReleaseYear"
                                  class="text-danger">
                            </span>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label asp-for="GenreId"
                                   class="form-label fw-semibold">
                                Genre
                            </label>

                            <select asp-for="GenreId"
                                    asp-items="ViewBag.Genres"
                                    class="form-select">
                                <option value="">
                                    -- Aucun genre --
                                </option>
                            </select>

                            <span asp-validation-for="GenreId"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-3 mb-3">
                            <label asp-for="Prix"
                                   class="form-label fw-semibold">
                                Prix
                            </label>

                            <input asp-for="Prix"
                                   class="form-control"
                                   type="number"
                                   step="0.01" />

                            <span asp-validation-for="Prix"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-3 mb-3">
                            <label asp-for="Stock"
                                   class="form-label fw-semibold">
                                Stock
                            </label>

                            <input asp-for="Stock"
                                   class="form-control"
                                   type="number" />

                            <span asp-validation-for="Stock"
                                  class="text-danger">
                            </span>
                        </div>

                    </div>

                    <div class="mb-3">
                        <label asp-for="PosterPath"
                               class="form-label fw-semibold">
                            Affiche
                        </label>

                        <input asp-for="PosterPath"
                               class="form-control" />

                        <span asp-validation-for="PosterPath"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description"
                               class="form-label fw-semibold">
                            Description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5">
                        </textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="d-flex justify-content-between">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Retour
                        </a>

                        <button type="submit"
                                class="btn btn-primary">
                            Enregistrer
                        </button>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}