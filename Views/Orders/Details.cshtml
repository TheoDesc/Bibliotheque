@model FilmLibrary.Models.Order

@{
    ViewData["Title"] = $"Commande #{Model.Id}";
}

<section class="checkout-page">

    <div class="checkout-header">

        <div class="catalog-eyebrow">
            <i class="bi bi-receipt"></i>
            COMMANDE #@Model.Id
        </div>

        <h1>Votre commande</h1>

        <p>
            Commandée le
            @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy à HH:mm")
        </p>

    </div>

    <div class="checkout-card">

        <h2>Films commandés</h2>

        @foreach (var item in Model.Items)
        {
            <div class="checkout-item">

                <div>

                    <strong>
                        @item.Film.Title
                    </strong>

                    <span>
                        @item.Quantity ×
                        @item.UnitPrice.ToString("0.00") €
                    </span>

                </div>

                <strong>
                    @((item.UnitPrice * item.Quantity).ToString("0.00")) €
                </strong>

            </div>
        }

        <div class="checkout-separator"></div>

        <div class="checkout-total">

            <span>Total</span>

            <strong>
                @Model.Total.ToString("0.00") €
            </strong>

        </div>

        <div class="mt-4">

            <h3>Adresse de livraison</h3>

            <p>
                @Model.DeliveryAddress
            </p>

        </div>

        <div class="mt-4">

            <span class="badge bg-success">
                @Model.Status
            </span>

        </div>

        <a asp-action="Index"
           class="btn btn-details mt-4">
            <i class="bi bi-arrow-left"></i>
            Retour à mes commandes
        </a>

    </div>

</section>