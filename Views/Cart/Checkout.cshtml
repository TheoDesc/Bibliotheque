@model List<FilmLibrary.Models.CartItem>

@{
    ViewData["Title"] = "Finaliser la commande";
    var total = Model.Sum(x => x.Prix * x.Quantity);
}

<section class="checkout-page">

    <div class="checkout-header">

        <div class="catalog-eyebrow">
            <i class="bi bi-box-seam"></i>
            COMMANDE
        </div>

        <h1>Finaliser votre commande</h1>

        <p>
            Renseignez votre adresse de livraison et vérifiez votre commande.
        </p>

    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="checkout-layout">

        <div class="checkout-card">

            <h2>Adresse de livraison</h2>

            <form asp-action="ConfirmOrder"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-4">

                    <label for="deliveryAddress"
                           class="form-label">
                        Adresse complète
                    </label>

                    <textarea id="deliveryAddress"
                              name="deliveryAddress"
                              class="form-control"
                              rows="4"
                              placeholder="12 rue de Paris, 75001 Paris"
                              required></textarea>

                </div>

                <h2 class="mt-4">
                    Votre commande
                </h2>

                @foreach (var item in Model)
                {
                    <div class="checkout-item">

                        <div>

                            <strong>
                                @item.Title
                            </strong>

                            <span>
                                @item.Quantity ×
                                @item.Prix.ToString("0.00") €
                            </span>

                        </div>

                        <strong>
                            @((item.Prix * item.Quantity).ToString("0.00")) €
                        </strong>

                    </div>
                }

                <div class="checkout-separator"></div>

                <div class="checkout-total">

                    <span>Total</span>

                    <strong>
                        @total.ToString("0.00") €
                    </strong>

                </div>

                <button type="submit"
                        class="btn btn-checkout mt-4">

                    Confirmer la commande

                    <i class="bi bi-arrow-right"></i>

                </button>

            </form>

        </div>

    </div>

</section>