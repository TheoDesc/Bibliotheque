@model List<FilmLibrary.Models.CartItem>

@{
    ViewData["Title"] = "Mon panier";
    var total = Model.Sum(x => x.Prix);
}

<section class="cart-header">
    <div>
        <div class="catalog-eyebrow">
            <i class="bi bi-cart3"></i>
            COMMANDE
        </div>

        <h1>Mon panier</h1>

        <p>
            Retrouvez les films que vous souhaitez louer.
        </p>
    </div>
</section>

@if (!Model.Any())
{
    <div class="empty-state">

        <i class="bi bi-cart-x"></i>

        <h2>Votre panier est vide</h2>

        <p>
            Ajoutez des films depuis le catalogue pour commencer votre commande.
        </p>

        <a asp-controller="Films"
           asp-action="Index"
           class="btn btn-primary-custom">
            <i class="bi bi-arrow-left"></i>
            Retour au catalogue
        </a>

    </div>
}
else
{
    <div class="cart-layout">

        <div class="cart-items">

            @foreach (var item in Model)
            {
                <article class="cart-item">

                    <div class="cart-poster">

                        @if (!string.IsNullOrEmpty(item.PosterPath))
                        {
                            <img src="@item.PosterPath"
                                 alt="@item.Title" />
                        }
                        else
                        {
                            <div class="poster-placeholder">
                                <i class="bi bi-film"></i>
                            </div>
                        }

                    </div>

                    <div class="cart-item-content">

                        <div>
                            <h2>@item.Title</h2>

                            <p>
                                Location du film
                            </p>
                        </div>

                        <div class="cart-item-bottom">

                            <strong>
                                @item.Prix.ToString("0.00") €
                            </strong>

                            <a asp-controller="Cart"
                               asp-action="Remove"
                               asp-route-id="@item.FilmId"
                               class="remove-link">
                                <i class="bi bi-trash3"></i>
                                Retirer
                            </a>

                        </div>

                    </div>

                </article>
            }

        </div>

        <aside class="cart-summary">

            <h2>Récapitulatif</h2>

            <div class="summary-line">
                <span>Films</span>
                <span>@Model.Count</span>
            </div>

            <div class="summary-line">
                <span>Sous-total</span>
                <span>@total.ToString("0.00") €</span>
            </div>

            <div class="summary-separator"></div>

            <div class="summary-total">
                <span>Total</span>
                <strong>@total.ToString("0.00") €</strong>
            </div>

            <a asp-controller="Cart"
               asp-action="Checkout"
               class="btn btn-checkout">
                Procéder au paiement
                <i class="bi bi-arrow-right"></i>
            </a>

            <a asp-controller="Films"
               asp-action="Index"
               class="continue-shopping">
                <i class="bi bi-arrow-left"></i>
                Continuer mes achats
            </a>

        </aside>

    </div>
}