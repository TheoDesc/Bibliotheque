@model IReadOnlyList<FilmLibrary.Models.Film>

@{
ViewData["Title"] = "Catalogue";
var genres = ViewBag.Genres as IEnumerable<FilmLibrary.Models.Genre>
              ?? Enumerable.Empty<FilmLibrary.Models.Genre>();

string? currentSearch = ViewBag.Search as string;
string? currentGenre = ViewBag.Genre as string;
double? currentMinPrice = ViewBag.MinPrice as double?;
double? currentMaxPrice = ViewBag.MaxPrice as double?;

}

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
    <div>
        <span class="text-uppercase small fw-semibold text-primary">
            CinéBiblio
        </span>

    <h1 class="display-6 fw-bold mb-1">
        Catalogue
    </h1>

    <p class="text-muted mb-0">
        Découvrez notre sélection de films.
    </p>
</div>

@if (User.IsInRole("Admin"))
{
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>
        Ajouter un film
    </a>
}

</div>

@if (TempData["Error"] != null)
{ <div class="alert alert-danger alert-dismissible fade show" role="alert"> <i class="bi bi-exclamation-circle me-2"></i>
@TempData["Error"]

    <button type="button"
            class="btn-close"
            data-bs-dismiss="alert"
            aria-label="Fermer">
    </button>
</div>

}

@if (TempData["Success"] != null)
{ <div class="alert alert-success alert-dismissible fade show" role="alert"> <i class="bi bi-check-circle me-2"></i>
@TempData["Success"]

    <button type="button"
            class="btn-close"
            data-bs-dismiss="alert"
            aria-label="Fermer">
    </button>
</div>

}

<!-- Filtres -->

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">

    <div class="d-flex align-items-center gap-2 mb-3">
        <i class="bi bi-funnel text-primary"></i>
        <h5 class="mb-0 fw-semibold">
            Rechercher et filtrer
        </h5>
    </div>

    <form asp-controller="Films"
          asp-action="Index"
          method="get">

        <div class="row g-3 align-items-end">

            <!-- Recherche -->
            <div class="col-12 col-lg-4">
                <label for="search" class="form-label fw-semibold">
                    Recherche
                </label>

                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>

                    <input type="text"
                           id="search"
                           name="search"
                           value="@currentSearch"
                           class="form-control"
                           placeholder="Titre, réalisateur ou description..." />
                </div>
            </div>

            <!-- Genre -->
            <div class="col-12 col-md-4 col-lg-2">
                <label for="genre" class="form-label fw-semibold">
                    Genre
                </label>

                <select id="genre"
                        name="genre"
                        class="form-select">

                    <option value="">
                        Tous
                    </option>

                    @foreach (var genre in genres)
                    {
                        if (currentGenre == genre.Name)
                        {
                            <option value="@genre.Name" selected>
                                @genre.Name
                            </option>
                        }
                        else
                        {
                            <option value="@genre.Name">
                                @genre.Name
                            </option>
                        }
                    }

                </select>
            </div>

            <!-- Prix minimum -->
            <div class="col-6 col-md-4 col-lg-2">
                <label for="minPrice" class="form-label fw-semibold">
                    Prix min.
                </label>

                <div class="input-group">
                    <input type="number"
                           id="minPrice"
                           name="minPrice"
                           value="@currentMinPrice"
                           class="form-control"
                           min="0"
                           step="0.01"
                           placeholder="0" />

                    <span class="input-group-text">
                        €
                    </span>
                </div>
            </div>

            <!-- Prix maximum -->
            <div class="col-6 col-md-4 col-lg-2">
                <label for="maxPrice" class="form-label fw-semibold">
                    Prix max.
                </label>

                <div class="input-group">
                    <input type="number"
                           id="maxPrice"
                           name="maxPrice"
                           value="@currentMaxPrice"
                           class="form-control"
                           min="0"
                           step="0.01"
                           placeholder="50" />

                    <span class="input-group-text">
                        €
                    </span>
                </div>
            </div>

            <!-- Boutons -->
            <div class="col-12 col-lg-2 d-flex gap-2">
                <button type="submit"
                        class="btn btn-primary flex-grow-1">
                    <i class="bi bi-funnel me-1"></i>
                    Filtrer
                </button>

                <a asp-controller="Films"
                   asp-action="Index"
                   class="btn btn-outline-secondary"
                   title="Réinitialiser">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>

        </div>

    </form>
</div>

</div>

<!-- Résultats -->

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">
        Films disponibles
    </h2>

<span class="badge text-bg-light border">
    @Model.Count film@(Model.Count > 1 ? "s" : "")
</span>

</div>

@if (!Model.Any())
{ <div class="card border-0 shadow-sm"> <div class="card-body text-center py-5">

        <i class="bi bi-film display-4 text-muted"></i>

        <h3 class="h5 mt-3">
            Aucun film trouvé
        </h3>

        <p class="text-muted mb-3">
            Aucun film ne correspond à vos critères de recherche.
        </p>

        <a asp-action="Index"
           class="btn btn-outline-primary">
            Réinitialiser les filtres
        </a>

    </div>
</div>

}
else
{ <div class="row g-4">

    @foreach (var film in Model)
    {
        <div class="col-12 col-sm-6 col-lg-4 col-xl-3">

            <div class="card h-100 border-0 shadow-sm film-card">

                @if (!string.IsNullOrWhiteSpace(film.PosterPath))
                {
                    <img src="@film.PosterPath"
                         class="card-img-top"
                         alt="Affiche de @film.Title"
                         style="height: 280px; object-fit: cover;" />
                }
                else
                {
                    <div class="film-poster-placeholder d-flex align-items-center justify-content-center"
                         style="height: 280px;">
                        <i class="bi bi-film display-4 text-muted"></i>
                    </div>
                }

                <div class="card-body d-flex flex-column">

                    <div class="mb-2">

                        @if (film.Genre != null)
                        {
                            <span class="badge rounded-pill text-bg-light border">
                                @film.Genre.Name
                            </span>
                        }

                        @if (film.Stock > 0)
                        {
                            <span class="badge rounded-pill text-bg-success">
                                Disponible
                            </span>
                        }
                        else
                        {
                            <span class="badge rounded-pill text-bg-danger">
                                Rupture
                            </span>
                        }

                    </div>

                    <h3 class="h5 fw-bold mb-2">
                        @film.Title
                    </h3>

                    <div class="small text-muted mb-3">

                        @if (film.ReleaseYear > 0)
                        {
                            <span>
                                <i class="bi bi-calendar3 me-1"></i>
                                @film.ReleaseYear
                            </span>
                        }

                        @if (!string.IsNullOrWhiteSpace(film.Director))
                        {
                            <span class="ms-2">
                                <i class="bi bi-person me-1"></i>
                                @film.Director
                            </span>
                        }

                    </div>

                    @if (!string.IsNullOrWhiteSpace(film.Description))
                    {
                        <p class="card-text text-muted small film-description">
                            @film.Description
                        </p>
                    }

                    <div class="mt-auto">

                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <span class="fs-5 fw-bold text-primary">
                                @film.Prix.ToString("0.00") €
                            </span>

                            <span class="small text-muted">
                                Stock : @film.Stock
                            </span>

                        </div>

                        <div class="d-grid gap-2">

                            <a asp-action="Details"
                               asp-route-id="@film.Id"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-eye me-1"></i>
                                Détails
                            </a>

                            @if (film.Stock > 0)
                            {
                                <a asp-controller="Cart"
                                   asp-action="Add"
                                   asp-route-id="@film.Id"
                                   class="btn btn-primary">
                                    <i class="bi bi-cart-plus me-1"></i>
                                    Ajouter au panier
                                </a>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <div class="d-flex gap-2">

                                    <a asp-action="Edit"
                                       asp-route-id="@film.Id"
                                       class="btn btn-sm btn-outline-warning flex-fill">
                                        <i class="bi bi-pencil"></i>
                                        Modifier
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@film.Id"
                                       class="btn btn-sm btn-outline-danger flex-fill">
                                        <i class="bi bi-trash"></i>
                                        Supprimer
                                    </a>

                                </div>
                            }

                        </div>

                    </div>

                </div>
            </div>

        </div>
    }

</div>

}
