@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<ul class="navbar-nav align-items-lg-center gap-2">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <span class="user-chip">
            <i class="bi bi-person-fill"></i>@((User.Identity!.Name ?? "").Split('@')[0])
            @if (User.IsInRole("Admin")) { <span class="chip c-1 ms-1">Admin</span> }
        </span>
    </li>
    <li class="nav-item">
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
            <button type="submit" class="btn btn-white btn-sm"><i class="bi bi-box-arrow-right me-1"></i>Déconnexion</button>
        </form>
    </li>
}
else
{
    <li class="nav-item"><a class="btn btn-white btn-sm" asp-area="Identity" asp-page="/Account/Register">Inscription</a></li>
    <li class="nav-item"><a class="btn btn-yellow btn-sm" asp-area="Identity" asp-page="/Account/Login">Connexion</a></li>
}
</ul>
