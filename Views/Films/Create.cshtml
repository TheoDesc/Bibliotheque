@model FilmFormViewModel
@{
    ViewData["Title"] = "Ajouter un film";
}

<div class="page-head">
    <span class="sticker sticker-yellow">Nouveau</span>
    <h1>Ajouter un film</h1>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="form-card">
    <partial name="_FilmFields" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-yellow"><i class="bi bi-check-lg me-1"></i>Enregistrer</button>
        <a asp-action="Index" class="btn btn-white">Annuler</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
