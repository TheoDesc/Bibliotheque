@model IReadOnlyList<Film>
@{
    ViewData["Title"] = "Catalogue";
    var isAdmin = User.IsInRole("Admin");
    var firstName = (User.Identity?.Name ?? "").Split('@')[0];
}

<section class="hero">
    <div class="hero-text">
        <span class="sticker sticker-yellow">🎬 Ma bibliothèque</span>
        <h1>Salut @firstName !</h1>
        <p>Parcours le catalogue et trouve ton prochain film.</p>
    </div>
    <div class="hero-side">
        <div class="stat-bubble"><strong>@Model.Count</strong><span>film@(Model.Count > 1 ? "s" : "")</span></div>
        @if (isAdmin)
        {
            <a class="btn btn-yellow btn-lg" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Ajouter un film</a>
        }
    </div>
</section>

@if (Model.Count == 0)
{
    <div class="form-card text-center">
        <div class="big-emoji">🍿</div>
        <p class="mb-0">Aucun film pour le moment.</p>
    </div>
}
else
{
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4 mt-1">
        @foreach (var film in Model)
        {
            var color = (film.Genre ?? "").Sum(ch => ch) % 5;
            <div class="col">
                <article class="film-card h-100">
                    <a asp-action="Details" asp-route-id="@film.Id" class="poster-wrap">
                        <partial name="_Poster" model="film" />
                        <span class="year-sticker">@film.ReleaseYear</span>
                    </a>
                    <div class="film-body">
                        <h2 class="film-title" title="@film.Title">@film.Title</h2>
                        @if (!string.IsNullOrEmpty(film.Genre))
                        {
                            <span class="chip c-@color">@film.Genre</span>
                        }
                        <div class="film-actions">
                            <a class="btn btn-violet btn-sm flex-grow-1" asp-action="Details" asp-route-id="@film.Id">Détails</a>
                            @if (isAdmin)
                            {
                                <a class="btn btn-white btn-sm" asp-action="Edit" asp-route-id="@film.Id" title="Modifier"><i class="bi bi-pencil-fill"></i></a>
                                <a class="btn btn-coral btn-sm" asp-action="Delete" asp-route-id="@film.Id" title="Supprimer"><i class="bi bi-trash-fill"></i></a>
                            }
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
