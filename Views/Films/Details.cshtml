@model FilmLibrary.Models.Film

@{
    ViewData["Title"] = Model.Title;
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9">

        <div class="card border-0 shadow-sm">

            <div class="row g-0">

                @if (!string.IsNullOrWhiteSpace(Model.PosterPath))
                {
                    <div class="col-md-4">
                        <img src="@Model.PosterPath"
                             class="img-fluid rounded-start h-100"
                             alt="@Model.Title"
                             style="object-fit: cover;" />
                    </div>
                }

                <div class="col-md-8">
                    <div class="card-body p-4">

                        <h1 class="h2 mb-2">
                            @Model.Title
                        </h1>

                        @if (Model.Genre != null)
                        {
                            <span class="badge text-bg-light border mb-3">
                                @Model.Genre.Name
                            </span>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.Director))
                        {
                            <p class="mb-2">
                                <strong>Réalisateur :</strong>
                                @Model.Director
                            </p>
                        }

                        @if (Model.ReleaseYear.HasValue)
                        {
                            <p class="mb-2">
                                <strong>Année :</strong>
                                @Model.ReleaseYear
                            </p>
                        }

                        @if (Model.DurationMinutes.HasValue)
                        {
                            <p class="mb-2">
                                <strong>Durée :</strong>
                                @Model.DurationMinutes minutes
                            </p>
                        }

                        <p class="mb-3">
                            <strong>Prix :</strong>
                            @Model.Prix.ToString("0.00") €
                        </p>

                        <p class="mb-3">
                            <strong>Stock :</strong>
                            @Model.Stock
                        </p>

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <div class="mb-4">
                                <h2 class="h5">
                                    Description
                                </h2>

                                <p class="text-muted">
                                    @Model.Description
                                </p>
                            </div>
                        }

                        <div class="d-flex gap-2">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Retour
                            </a>

                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@Model.Id"
                                   class="btn btn-primary">
                                    Modifier
                                </a>
                            }

                        </div>

                    </div>
                </div>

            </div>

        </div>

    </div>
</div>