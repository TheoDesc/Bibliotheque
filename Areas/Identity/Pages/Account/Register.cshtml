@page
@model FilmLibrary.Areas.Identity.Pages.Account.RegisterModel

@{
    ViewData["Title"] = "Inscription";
}

<div class="auth-page">

    <div class="auth-card">

        <div class="auth-icon">
            <i class="bi bi-person-plus"></i>
        </div>

        <h1>Créer un compte</h1>

        <p class="auth-subtitle">
            Rejoignez CinéBiblio et commencez à louer vos films.
        </p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                @Model.ErrorMessage
            </div>
        }

        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">

                <label asp-for="Input.Email"
                       class="form-label">
                    Adresse e-mail
                </label>

                <input asp-for="Input.Email"
                       class="form-control"
                       placeholder="vous@exemple.com" />

                <span asp-validation-for="Input.Email"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="Input.Password"
                       class="form-label">
                    Mot de passe
                </label>

                <input asp-for="Input.Password"
                       class="form-control"
                       placeholder="••••••••" />

                <span asp-validation-for="Input.Password"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="Input.ConfirmPassword"
                       class="form-label">
                    Confirmer le mot de passe
                </label>

                <input asp-for="Input.ConfirmPassword"
                       class="form-control"
                       placeholder="••••••••" />

                <span asp-validation-for="Input.ConfirmPassword"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-4">

                <label asp-for="Input.Role"
                       class="form-label">
                    Type de compte
                </label>

                <select asp-for="Input.Role"
                        class="form-select">

                    <option value="User">
                        Utilisateur
                    </option>

                    <option value="Admin">
                        Administrateur
                    </option>

                </select>

            </div>

            <div class="mb-3">

                <label asp-for="Input.AdminCode"
                       class="form-label">
                    Code administrateur
                </label>

                <input asp-for="Input.AdminCode"
                       class="form-control"
                       placeholder="Obligatoire uniquement pour Admin" />

                <small class="text-muted">
                    Le code est nécessaire pour créer un compte administrateur.
                </small>

            </div>

            <button type="submit"
                    class="btn btn-primary-custom w-100">

                <i class="bi bi-person-check"></i>

                Créer mon compte

            </button>

        </form>

        <div class="auth-footer">

            Déjà inscrit ?

            <a asp-page="/Account/Login">
                Se connecter
            </a>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}