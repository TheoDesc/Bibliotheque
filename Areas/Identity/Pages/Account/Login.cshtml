@page
@model FilmLibrary.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Connexion";
}

<div class="auth-page">

    <div class="auth-card">

        <div class="auth-icon">
            <i class="bi bi-box-arrow-in-right"></i>
        </div>

        <h1>Connexion</h1>

        <p class="auth-subtitle">
            Connectez-vous à votre compte CinéBiblio.
        </p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                @Model.ErrorMessage
            </div>
        }

        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">

                <label asp-for="Input.Email"
                       class="form-label">
                    Adresse e-mail
                </label>

                <input asp-for="Input.Email"
                       class="form-control"
                       placeholder="vous@exemple.com" />

                <span asp-validation-for="Input.Email"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-4">

                <label asp-for="Input.Password"
                       class="form-label">
                    Mot de passe
                </label>

                <input asp-for="Input.Password"
                       class="form-control"
                       placeholder="••••••••" />

                <span asp-validation-for="Input.Password"
                      class="text-danger">
                </span>

            </div>

            <button type="submit"
                    class="btn btn-primary-custom w-100">

                <i class="bi bi-box-arrow-in-right"></i>

                Se connecter

            </button>

        </form>

        <div class="auth-footer">

            Pas encore de compte ?

            <a asp-page="/Account/Register">
                Créer un compte
            </a>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}