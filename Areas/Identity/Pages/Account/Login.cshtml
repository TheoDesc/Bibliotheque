@page
@model LoginModel
@{
    ViewData["Title"] = "Connexion";
}

<div class="auth-wrap">
    <section class="auth-art d-none d-lg-flex">
        <partial name="_AuthArt" />
        <h2>Ton ciné, ta bibliothèque.</h2>
        <p>Retrouve tous tes films préférés au même endroit.</p>
    </section>

    <section class="auth-card">
        <span class="sticker sticker-violet">Bon retour 👋</span>
        <h1>Connexion</h1>
        <p class="text-muted-ink">Entre tes identifiants pour accéder au catalogue.</p>

        <form id="account" method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="toi@exemple.com" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Mot de passe</label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>
            <div class="form-check mb-4">
                <input asp-for="Input.RememberMe" class="form-check-input" />
                <label asp-for="Input.RememberMe" class="form-check-label">Se souvenir de moi</label>
            </div>

            <button type="submit" class="btn btn-yellow w-100 btn-lg">Se connecter</button>
        </form>

        <p class="text-center mt-4 mb-0">
            Pas encore de compte ?
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="link-pop">Inscris-toi</a>
        </p>

        <div class="demo-note mt-4">
            <strong>Comptes de test</strong><br />
            Admin : admin@films.local / Admin123!<br />
            User : user@films.local / User123!
        </div>
    </section>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
